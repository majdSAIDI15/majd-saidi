---
import { experience, education, achievements } from '../data/experience';
---

<section class="glass relative overflow-hidden py-16">
  <div class="absolute bottom-0 left-0 h-64 w-64 rounded-full bg-secondary opacity-5 blur-3xl"></div>
  <div class="relative mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    <div class="grid grid-cols-1 gap-12 md:grid-cols-2">
      <!-- Experience -->
      <div>
        <h3 class="mb-8 flex items-center text-2xl font-bold text-gray-800">
          <i class="fas fa-briefcase mr-3 text-primary"></i> Experience
        </h3>
        <div class="timeline relative pl-8">
          {
            experience.map((item) => (
              <div class="timeline-item relative mb-8 last:mb-0">
                <h4 class="text-lg font-semibold text-gray-800">{item.title}</h4>
                <p class="mb-2 text-primary">{item.org}</p>
                <p class="text-gray-600">{item.description}</p>
              </div>
            ))
          }
        </div>
      </div>

      <!-- Education + Achievements -->
      <div>
        <h3 class="mb-8 flex items-center text-2xl font-bold text-gray-800">
          <i class="fas fa-graduation-cap mr-3 text-primary"></i> Education
        </h3>
        <div class="timeline relative pl-8">
          {
            education.map((item) => (
              <div class="timeline-item relative mb-8 last:mb-0">
                <h4 class="text-lg font-semibold text-gray-800">{item.title}</h4>
                <p class="mb-2 text-primary">{item.org}</p>
                <p class="text-gray-600">{item.description}</p>
              </div>
            ))
          }
        </div>

        <h3 class="mb-8 mt-12 flex items-center text-2xl font-bold text-gray-800">
          <i class="fas fa-trophy mr-3 text-primary"></i> Achievements
        </h3>
        <div class="timeline relative pl-8">
          {
            achievements.map((item) => (
              <div class="timeline-item relative mb-4 last:mb-0">
                <p class="text-gray-700">{item}</p>
              </div>
            ))
          }
        </div>
      </div>
    </div>
  </div>
</section>
