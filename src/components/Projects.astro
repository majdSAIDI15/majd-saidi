---
import { projects } from '../data/projects';
import SectionHeading from './SectionHeading.astro';
import ProjectModal from './ProjectModal.astro';

// Literal class strings so Tailwind keeps them (no dynamic concatenation).
const categoryBadge: Record<string, string> = {
  AI: 'bg-blue-100 text-blue-700',
  'Voice AI': 'bg-indigo-100 text-indigo-700',
  'Full-Stack': 'bg-sky-100 text-sky-700',
  IoT: 'bg-orange-100 text-orange-700',
  'Computer Vision': 'bg-teal-100 text-teal-700',
  'Deep Learning': 'bg-red-100 text-red-700',
  Cybersecurity: 'bg-gray-200 text-gray-800',
  Automation: 'bg-green-100 text-green-700',
};
---

<section id="projects" class="relative overflow-hidden py-16">
  <div class="grid-overlay"></div>
  <div class="absolute right-1/4 top-1/4 h-64 w-64 rounded-full bg-primary opacity-5 blur-3xl"></div>

  <div class="relative z-10 mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    <SectionHeading title="My Projects" />

    <div class="grid grid-cols-1 gap-8 md:grid-cols-2 lg:grid-cols-3">
      {
        projects.map((project) => (
          <article class="card-hover blue-border group relative flex cursor-pointer flex-col overflow-hidden rounded-xl glass transition-shadow hover:bg-white/90 hover:ring-2 hover:ring-primary/40">
            {/* Full-card click target — opens the case study. Real links sit above it (z-20). */}
            {project.details && (
              <button
                type="button"
                class="project-open absolute inset-0 z-10"
                data-open-modal={project.slug}
                aria-label={`View ${project.title} case study`}
              />
            )}

            <div class="relative h-48 overflow-hidden">
              {project.media.type === 'video' && (
                <video autoplay muted loop playsinline class="project-image h-full w-full object-cover">
                  <source src={project.media.src} type="video/mp4" />
                </video>
              )}
              {project.media.type === 'image' && (
                <img
                  src={project.media.src}
                  alt={project.media.alt}
                  width="400"
                  height="192"
                  loading="lazy"
                  class="project-image h-full w-full object-cover"
                />
              )}
              {project.media.type === 'icon' && (
                <div class="project-image flex h-full w-full items-center justify-center bg-gradient-to-br from-primary to-secondary">
                  <i class={`${project.media.icon} text-6xl text-white/90`} />
                </div>
              )}

              {/* Persistent click cue */}
              {project.details && (
                <span class="pointer-events-none absolute right-3 top-3 z-20 inline-flex items-center gap-1 rounded-full bg-white/90 px-2.5 py-1 text-xs font-medium text-primary shadow-sm backdrop-blur transition-transform duration-300 group-hover:scale-105">
                  <i class="fas fa-up-right-from-square"></i> Case study
                </span>
              )}

              {/* Hover overlay */}
              <div class="absolute inset-0 flex items-end bg-gradient-to-t from-black/80 to-transparent p-6 opacity-0 transition-all duration-300 group-hover:opacity-100">
                <div>
                  <h3 class="mb-1 text-xl font-bold text-white">{project.title}</h3>
                  <p class="text-sm text-gray-300">{project.summary}</p>
                  <span class="mt-2 inline-flex items-center text-xs font-medium text-secondary">
                    <i class="fas fa-up-right-from-square mr-1"></i> Click to view details
                  </span>
                </div>
              </div>
            </div>

            <div class="flex flex-1 flex-col p-6">
              <div class="mb-2 flex items-start justify-between">
                <h3 class="text-xl font-bold text-gray-800">{project.title}</h3>
                <span class={`rounded-full px-2 py-1 text-xs ${categoryBadge[project.category] ?? 'bg-blue-100 text-primary'}`}>
                  {project.category}
                </span>
              </div>
              <p class="mb-4 text-gray-600">{project.description}</p>

              {project.highlight && (
                <p class="mb-4 rounded-lg bg-blue-50 px-3 py-2 text-sm font-medium text-primary">{project.highlight}</p>
              )}

              <div class="mb-4 flex flex-wrap gap-2">
                {project.tags.map((tag) => (
                  <span class="rounded bg-blue-50 px-2 py-1 text-xs text-gray-700">{tag}</span>
                ))}
              </div>

              <div class="mt-auto flex items-center justify-between gap-3 pt-2">
                {project.details ? (
                  <span class="inline-flex items-center font-medium text-primary">
                    View case study
                    <i class="fas fa-arrow-right ml-2 transition-transform duration-300 group-hover:translate-x-1"></i>
                  </span>
                ) : (
                  <span />
                )}

                {/* Real links sit above the full-card overlay */}
                <div class="relative z-20 flex space-x-3">
                  {project.code && (
                    <a href={project.code} target="_blank" rel="noopener noreferrer" aria-label="Source code" class="text-primary transition hover:text-gray-800">
                      <i class="fab fa-github"></i>
                    </a>
                  )}
                  {project.demo && (
                    <a href={project.demo} target="_blank" rel="noopener noreferrer" aria-label="Live demo" class="text-primary transition hover:text-gray-800">
                      <i class="fas fa-external-link-alt"></i>
                    </a>
                  )}
                </div>
              </div>
            </div>
          </article>
        ))
      }
    </div>
  </div>

  <ProjectModal />
</section>
