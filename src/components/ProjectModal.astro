---
import { projects } from '../data/projects';

const categoryBadge: Record<string, string> = {
  AI: 'bg-blue-100 text-blue-700',
  'Voice AI': 'bg-indigo-100 text-indigo-700',
  'Full-Stack': 'bg-sky-100 text-sky-700',
  IoT: 'bg-orange-100 text-orange-700',
  'Computer Vision': 'bg-teal-100 text-teal-700',
  'Deep Learning': 'bg-red-100 text-red-700',
  Cybersecurity: 'bg-gray-200 text-gray-800',
  Automation: 'bg-green-100 text-green-700',
};

const withDetails = projects.filter((p) => p.details);
---

{
  withDetails.map((project) => {
    const d = project.details!;
    return (
      <dialog id={`pm-${project.slug}`} class="project-modal" aria-labelledby={`pm-${project.slug}-title`}>
        <article class="modal-card">
          <!-- Header -->
          <header class="sticky top-0 z-10 flex items-start justify-between gap-4 border-b border-blue-100 bg-white/95 px-6 py-5 backdrop-blur md:px-8">
            <div>
              <span class={`mb-2 inline-block rounded-full px-2 py-1 text-xs font-medium ${categoryBadge[project.category] ?? 'bg-blue-100 text-primary'}`}>
                {project.category}
              </span>
              <h3 id={`pm-${project.slug}-title`} class="font-tech text-2xl font-bold text-gray-900">
                {project.title}
              </h3>
              <p class="mt-1 text-gray-600">{d.tagline}</p>
              {d.context && <p class="mt-1 text-sm font-medium text-primary">{d.context}</p>}
            </div>
            <button
              type="button"
              class="modal-close shrink-0 rounded-full border border-gray-200 p-2 text-gray-500 transition hover:bg-gray-100 hover:text-gray-800"
              aria-label="Close"
            >
              <i class="fas fa-xmark text-lg"></i>
            </button>
          </header>

          <!-- Body -->
          <div class="space-y-8 px-6 py-6 md:px-8">
            <p class="leading-relaxed text-gray-700">{d.overview}</p>

            <!-- Highlights -->
            <section>
              <h4 class="mb-3 flex items-center text-sm font-semibold uppercase tracking-wide text-gray-500">
                <i class="fas fa-bolt mr-2 text-primary"></i> Highlights
              </h4>
              <ul class="grid grid-cols-1 gap-2 md:grid-cols-2">
                {d.features.map((f) => (
                  <li class="flex items-start text-gray-700">
                    <i class="fas fa-circle-check mr-2 mt-1 text-primary"></i>
                    <span set:html={f} />
                  </li>
                ))}
              </ul>
            </section>

            <!-- Stack -->
            <section>
              <h4 class="mb-3 flex items-center text-sm font-semibold uppercase tracking-wide text-gray-500">
                <i class="fas fa-layer-group mr-2 text-primary"></i> Tech Stack
              </h4>
              <div class="space-y-3">
                {d.stack.map((g) => (
                  <div class="flex flex-col gap-2 sm:flex-row sm:items-center">
                    <span class="w-40 shrink-0 text-sm font-medium text-gray-600">{g.group}</span>
                    <div class="flex flex-wrap gap-2">
                      {g.items.map((item) => (
                        <span class="rounded bg-blue-50 px-2 py-1 text-xs text-blue-700">{item}</span>
                      ))}
                    </div>
                  </div>
                ))}
              </div>
            </section>

            {d.note && (
              <p class="flex items-start rounded-lg border border-amber-200 bg-amber-50 px-4 py-3 text-sm text-amber-800">
                <i class="fas fa-circle-info mr-2 mt-0.5"></i>
                <span>{d.note}</span>
              </p>
            )}

            <!-- Gallery -->
            {d.gallery && d.gallery.length > 0 && (
              <section>
                <h4 class="mb-3 flex items-center text-sm font-semibold uppercase tracking-wide text-gray-500">
                  <i class="fas fa-images mr-2 text-primary"></i> Gallery
                </h4>
                <div class="grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-3">
                  {d.gallery.map((img) => (
                    <figure class="group/g overflow-hidden rounded-xl border border-blue-100 bg-white">
                      <button type="button" class="gallery-item block w-full" data-full={img.src} data-caption={img.caption}>
                        <img
                          src={img.src}
                          alt={img.caption}
                          loading="lazy"
                          class="h-44 w-full cursor-zoom-in object-cover transition-transform duration-300 group-hover/g:scale-105"
                        />
                      </button>
                      <figcaption class="px-3 py-2 text-xs text-gray-600">{img.caption}</figcaption>
                    </figure>
                  ))}
                </div>
              </section>
            )}
          </div>

          <!-- Footer / links -->
          {(project.code || project.demo || (d.links && d.links.length > 0)) && (
            <footer class="flex flex-wrap gap-3 border-t border-blue-100 px-6 py-5 md:px-8">
              {project.demo && (
                <a href={project.demo} target="_blank" rel="noopener noreferrer" class="inline-flex items-center rounded-lg bg-gradient-to-r from-primary to-secondary px-4 py-2 text-sm font-medium text-white transition hover:shadow-lg">
                  <i class="fas fa-external-link-alt mr-2"></i> Live demo
                </a>
              )}
              {project.code && (
                <a href={project.code} target="_blank" rel="noopener noreferrer" class="inline-flex items-center rounded-lg border border-primary px-4 py-2 text-sm font-medium text-primary transition hover:bg-blue-50">
                  <i class="fab fa-github mr-2"></i> Source
                </a>
              )}
              {d.links?.map((l) => (
                <a href={l.href} target="_blank" rel="noopener noreferrer" class="inline-flex items-center rounded-lg border border-gray-200 px-4 py-2 text-sm font-medium text-gray-700 transition hover:bg-gray-50">
                  <i class={`${l.icon} mr-2`} /> {l.label}
                </a>
              ))}
            </footer>
          )}
        </article>
      </dialog>
    );
  })
}

<!-- Shared lightbox (a dialog so it stacks above the open project modal's top layer) -->
<dialog id="lightbox" class="lightbox-dialog" aria-label="Image preview">
  <button id="lightbox-close" type="button" class="absolute right-4 top-4 z-10 rounded-full bg-white/10 p-3 text-white transition hover:bg-white/20" aria-label="Close preview">
    <i class="fas fa-xmark text-xl"></i>
  </button>
  <figure class="flex max-h-full max-w-5xl flex-col items-center px-4">
    <img id="lightbox-img" src="" alt="" class="max-h-[82vh] w-auto rounded-lg object-contain" />
    <figcaption id="lightbox-caption" class="mt-3 text-center text-sm text-white/80"></figcaption>
  </figure>
</dialog>

<style>
  .project-modal {
    width: min(95vw, 56rem);
    max-height: 90vh;
    padding: 0;
    border: none;
    border-radius: 1rem;
    overflow: hidden;
    background: transparent;
  }
  .project-modal::backdrop {
    background: rgba(8, 20, 40, 0.55);
    backdrop-filter: blur(4px);
  }
  .project-modal .modal-card {
    max-height: 90vh;
    overflow-y: auto;
    background: #fff;
    border-radius: 1rem;
  }
  /* Entry animation */
  .project-modal[open] {
    animation: modal-pop 0.28s cubic-bezier(0.16, 1, 0.3, 1);
  }
  @keyframes modal-pop {
    from { transform: translateY(16px) scale(0.97); opacity: 0; }
    to { transform: translateY(0) scale(1); opacity: 1; }
  }
  @media (prefers-reduced-motion: reduce) {
    .project-modal[open] { animation: none; }
  }

  /* Lightbox dialog — full-viewport overlay above the project modal */
  .lightbox-dialog {
    max-width: 100vw;
    max-height: 100vh;
    width: 100vw;
    height: 100vh;
    margin: 0;
    padding: 0;
    border: none;
    background: transparent;
  }
  .lightbox-dialog::backdrop {
    background: rgba(0, 0, 0, 0.88);
  }
  .lightbox-dialog[open] {
    display: flex;
    align-items: center;
    justify-content: center;
  }
</style>
